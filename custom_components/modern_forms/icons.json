{
  "entity": {
    "binary_sensor": {
      "fan_sleep_timer_active": {
        "default": "mdi:av-timer"
      },
      "light_sleep_timer_active": {
        "default": "mdi:av-timer"
      }
    },
    "light": {
      "light": {
        "default": "mdi:ceiling-fan-light"
      },
      "downlight": {
        "default": "mdi:ceiling-fan-light"
      },
      "uplight": {
        "default": "mdi:wall-sconce-round-variant"
      }
    },
    "sensor": {
      "fan_timer_remaining_time": {
        "default": "mdi:timer-outline"
      },
      "light_timer_remaining_time": {
        "default": "mdi:timer-outline"
      }
    },
    "switch": {
      "adaptive_learning": {
        "default": "mdi:school-outline"
      },
      "away_mode": {
        "default": "mdi:airplane-takeoff"
      },
      "breeze_mode": {
        "default": "mdi:weather-windy"
      }
    }
  },
  "services": {
    "clear_fan_sleep_timer": {
      "service": "mdi:timer-cancel"
    },
    "clear_light_sleep_timer": {
      "service": "mdi:timer-cancel"
    },
    "set_fan_sleep_timer": {
      "service": "mdi:timer"
    },
    "set_light_sleep_timer": {
      "service": "mdi:timer"
    }
  }
}
